# @BotFather'dan olingan token
BOT_TOKEN=

# Mini App HTTPS manzili (dev: cloudflared/ngrok tunnel URL, prod: domen)
WEBAPP_URL=

# console.anthropic.com dan (3-bosqichda kerak bo'ladi)
ANTHROPIC_API_KEY=

# Admin Telegram ID (bot statistika buyruqlari uchun)
ADMIN_ID=

# ⚠️ FAQAT LOKAL ISHLAB CHIQISH UCHUN — Telegram imzo tekshiruvini o'chiradi.
# Serverda HECH QACHON 1 qilmang. Xavfsizlik uchun bu bayroq BOT_TOKEN bo'sh
# bo'lgandagina ishlaydi, ya'ni prod'da tasodifan qolib ketsa ham zarar bermaydi.
DEV_AUTH=0

# SQLite fayli yo'li (prod: doimiy disk, masalan /opt/arabiy/data/arabiy.db)
DB_PATH=

# ── AI ustoz (jonli suhbat) ──
# Suhbat modeli (bo'sh qoldirsangiz Haiku 4.5). VIP kunlik limiti va VIP'siz bepul javoblar.
TUTOR_MODEL=claude-haiku-4-5-20251001
# VIP suhbat + mock uchun kuchliroq model: Sonnet 5.5 ($2/$10 — Haiku'dan 2× narx). Bepul o'quvchilar Haiku'da qoladi.
# Bu qator .env da BOR bo'lsa kod standartidan ustun: bo'sh qoldirsangiz (TUTOR_VIP_MODEL=) VIP ham TUTOR_MODEL'da bo'ladi.
TUTOR_VIP_MODEL=claude-sonnet-5-5
# Qo'lyozma (daftar surati) o'qish modeli; xato bersa TUTOR_MODEL. Bo'sh qoldirsangiz shu ham Haiku.
WRITING_MODEL=claude-sonnet-5-5
TUTOR_DAILY_TURNS=30
TUTOR_FREE_TURNS=3

# ── VIP tarif va to'lov ──
# Pul tushadigan karta (Uzcard/Humo) va egasi — ilovada ko'rsatiladi
PAY_CARD_NUMBER=
PAY_CARD_HOLDER=
# Narxlar (so'm). Eski narx chegirma uchun; 0 = chegirma va taymer yo'q
PAY_PRICE_MONTH=40000
PAY_PRICE_3MONTH=100000
PAY_OLD_PRICE_MONTH=90000
PAY_OLD_PRICE_3MONTH=240000
PAY_DISCOUNT_HOURS=24
# Savollar uchun Telegram username (@ belgisisiz)
SUPPORT_USERNAME=

# Ovozni matnga aylantirish (speaking). console.groq.com dan kalit.
# OpenAI ishlatmoqchi bo'lsangiz: STT_BASE_URL=https://api.openai.com/v1, STT_MODEL=gpt-4o-mini-transcribe
STT_API_KEY=
STT_BASE_URL=https://api.groq.com/openai/v1
STT_MODEL=whisper-large-v3
# K21.7 OpenAI STT (ixtiyoriy): kalit bo'lsa ovoz avval gpt-4o-transcribe orqali (aksentga chidamliroq,
# ~$0.006/daqiqa), xato yoki limitda yuqoridagi Groq zaxira. platform.openai.com → API keys → sk-…
STT_OPENAI_API_KEY=
STT_OPENAI_MODEL=gpt-4o-transcribe

# ── K30 Jonli ovozli suhbat (Google Gemini Live API) ──
# Kalit: aistudio.google.com → Get API key. Bo'sh bo'lsa «🎙 Jonli AI bilan suhbat» tugmasi ko'rinmaydi.
GEMINI_API_KEY=
# LIVE_MODEL=gemini-3.8-live
# LIVE_VOICE=Charon
# Bitta suhbat (soniya) va jimlikda yopish (soniya)
# LIVE_MAX_SECONDS=540
# LIVE_IDLE_SECONDS=60
# Limit (0 = cheklovsiz): bepul — kuniga, VIP — 30 kunda, soniyada. Masalan 120 va 3600.
# LIVE_FREE_SECONDS_DAY=0
# LIVE_VIP_SECONDS_MONTH=0
# Kunlik sarf shundan oshsa adminga ogohlantirish (USD), limit emas
# LIVE_DAILY_BUDGET_USD=5

# «🔄 Bot yangilandi» xabari har nechta deploydan bittasida o'quvchilarga boradi (0 = hech qachon)
# DEPLOY_NOTIFY_EVERY=10
