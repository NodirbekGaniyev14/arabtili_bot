# @BotFather'dan olingan token
BOT_TOKEN=

# Mini App HTTPS manzili (dev: cloudflared/ngrok tunnel URL, prod: domen)
WEBAPP_URL=

# console.anthropic.com dan (3-bosqichda kerak bo'ladi)
ANTHROPIC_API_KEY=

# Admin Telegram ID (bot statistika buyruqlari uchun)
ADMIN_ID=

# ⚠️ FAQAT LOKAL ISHLAB CHIQISH UCHUN — Telegram imzo tekshiruvini o'chiradi.
# Serverda HECH QACHON 1 qilmang. Xavfsizlik uchun bu bayroq BOT_TOKEN bo'sh
# bo'lgandagina ishlaydi, ya'ni prod'da tasodifan qolib ketsa ham zarar bermaydi.
DEV_AUTH=0

# SQLite fayli yo'li (prod: doimiy disk, masalan /opt/arabiy/data/arabiy.db)
DB_PATH=

# ── AI ustoz (jonli suhbat) ──
# Suhbat modeli (bo'sh qoldirsangiz Haiku 4.5). Kunlik limit: har foydalanuvchiga javoblar soni.
TUTOR_MODEL=claude-haiku-4-5-20251001
TUTOR_DAILY_TURNS=40

# Ovozni matnga aylantirish (speaking). console.groq.com dan kalit.
# OpenAI ishlatmoqchi bo'lsangiz: STT_BASE_URL=https://api.openai.com/v1, STT_MODEL=gpt-4o-mini-transcribe
STT_API_KEY=
STT_BASE_URL=https://api.groq.com/openai/v1
STT_MODEL=whisper-large-v3-turbo
