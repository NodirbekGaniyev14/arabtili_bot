    "uz": "Tomoqdan chiqadigan ovoz (o'zbekchada yo'q)",
    "form": "عَ"
   },
   {
    "ar": "غ",
    "uz": "O'zbekcha 'g'' (غ) — g'oz, g'arb",
    "form": "غَ"
   }
  ],
  "common_mistakes_uz": [
   "ع ni oddiy 'a' deb o'qish — u tomoqdan chiqadi, oddiy unli emas.",
   "ع va غ ni chalkashtirish: غ = g', ع = tomoq ovozi.",
   "ط ni oddiy 't' deb yozish — u qalin, og'izni to'ldirib aytiladi.",
   "ظ va ز ni aralashtirish: ظ qalin, ز yupqa."
  ]
 },
