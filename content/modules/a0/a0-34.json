 "harakat_level": "full",
 "hook_uz": "\"Arab\" so'zi خ bilan emas, ع bilan boshlanadi: عَرَب. Bu tovush o'zbekda YO'Q — u tomog'ing chuqurida tug'iladi. \"Ilm\", \"Ali\", \"asr\" so'zlaridagi jimgina 'e' aslida ع edi! Bugun uni va uning qo'shnisi ح ni ushlaymiz.",
 "grammar": {
  "point_ar": "ع · ح",
  "explanation_uz": "ع va ح — ikkalasi ham tomoq (bo'g'iz) o'rtasidan chiqadi va o'zbek tilida aniq muqobili yo'q. ع — ovozli (jarangli), tomoqni bir oz siqib 'a' chiqargandek. ح — ovozsiz, xuddi issiq oynaga 'haaa' deb nafas urgandek, lekin kuchliroq va tomoqdan. Diqqat: ح ≠ o'zbekcha 'h', ح ≠ خ (x). ع ni ko'pincha ' (hamza / to'xtash) bilan adashtirishadi — lekin ع jarangli va cho'ziladi.",
  "table": [
   {
    "ar": "ع",
    "uz": "jarangli bo'g'iz tovushi (o'zbekda YO'Q)",
    "form": "tomoq siqiladi, ovoz bilan"
   },
   {
    "ar": "ح",
    "uz": "ovozsiz bo'g'iz 'h' (kuchli nafas)",
    "form": "issiq nafas, ovozsiz"
   },
   {
    "ar": "خ",
    "uz": "x (o'zbekda BOR — 'xato')",
    "form": "solishtirish uchun"
   },
   {
    "ar": "ه",
    "uz": "yumshoq h (o'zbekcha 'havo')",
    "form": "solishtirish uchun"
   }
  ],
  "common_mistakes_uz": [
   "ع ni oddiy 'a' deb o'qish — yo'q, tomoqni siqish kerak: عَرَب ('arab).",
   "ح ni o'zbekcha yumshoq 'h' deb aytish — ح kuchliroq va tomoqdan chiqadi: حَجّ (hajj).",
   "ح ni خ (x) bilan aralashtirish — ح da 'xirillash' yo'q.",
   "ع ni hamza (to'xtash ') bilan chalkashtirish — ع jarangli va cho'ziluvchan."
  ]
 },
