   },
   {
    "ar": "ـة",
    "uz": "oldingi harfga ulanadi",
    "form": "ulangan"
   },
   {
    "ar": "مَدْرَسة",
    "uz": "maktab (madrasa)",
    "form": "misol"
   },
   {
    "ar": "سَاعة",
    "uz": "soat",
    "form": "misol"
   },
   {
    "ar": "مَدِينة",
    "uz": "shahar",
    "form": "misol"
   }
  ],
  "common_mistakes_uz": [
   "ة ni oddiy ت (ta) deb o'qib yuborish — u so'z oxirida yumshoq \"a/h\" bo'ladi.",
   "ة ni ه (ha) bilan chalkashtirish — ta marbutada ustida IKKITA nuqta bor.",
   "ة ni so'z o'rtasida yozish — u FAQAT so'z oxirida keladi.",
   "Oldidagi fatha (a) ni unutish — ta marbutadan oldin deyarli doim \"a\" tovushi bo'ladi."
  ]
 },
