   {"ar": "ن", "uz": "TEPADA 1 nuqta", "form": "n"},
   {"ar": "ي", "uz": "PASTDA 2 nuqta", "form": "y"},
   {"ar": "ق", "uz": "TEPADA 2 nuqta", "form": "q"},
   {"ar": "ش", "uz": "TEPADA 3 nuqta", "form": "sh"}
  ],
  "common_mistakes_uz": [
   "ب va ن ni chalkashtirish — ikkalasida 1 nuqta, lekin joyi boshqa (past/tepa).",
   "ت va ق ni faqat nuqta soniga qarab ajratmaslik — tanasi ham boshqa.",
   "3 nuqtali ث va ش ni chalkashtirish — ث kosachali, ش taroqli."
  ]
 },
