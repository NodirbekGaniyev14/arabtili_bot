 ],
 "harakat_level": "full",
 "hook_uz": "«Kitob» so'zini bilasizmi? Arabchada u كِتَاب — o'rtadagi «taa» tovushi cho'ziladi: ki-taaab. Bugun uch sehrli harf — ا و ي qanday qilib unlini cho'zishini o'rganamiz.",
 "grammar": {
  "point_ar": "حُرُوف المَدّ: ا · و · ي",
  "explanation_uz": "Uch harf — ا, و, ي — ba'zan undosh emas, balki oldingi qisqa unlini cho'zish uchun keladi. Bunda ular ustiga hech qanday harakat qo'yilmaydi. Qoida oddiy: qaysi qisqa harakat kelsa, o'sha cho'ziladi. Fatha (a) + ا = ā (aa). Damma (u) + و = ū (uu). Kasra (i) + ي = ī (ii).",
  "table": [
   {
    "ar": "بَ + ا = بَا",
    "uz": "«ba» → «baa» (uzun a)",
    "form": "ا cho'zadi"
   },
   {
    "ar": "نُ + و = نُو",
    "uz": "«nu» → «nuu» (uzun u)",
    "form": "و cho'zadi"
   },
   {
    "ar": "دِ + ي = دِي",
    "uz": "«di» → «dii» (uzun i)",
    "form": "ي cho'zadi"
   },
   {
    "ar": "بَاب",
    "uz": "baab (eshik) — ا ni cho'z",
    "form": "misol"
   },
   {
    "ar": "نُور",
    "uz": "nuur (nur) — و ni cho'z",
    "form": "misol"
   },
   {
    "ar": "دِين",
    "uz": "diin (din) — ي ni cho'z",
    "form": "misol"
   }
  ],
  "common_mistakes_uz": [
   "Cho'ziq unlini qisqa o'qish: كِتَاب ni «kitab» emas, «kitaab» deb cho'zish kerak.",
   "Madd harfiga harakat qo'yish: cho'zuvchi ا و ي ustiga hech qachon fatha/kasra/damma qo'yilmaydi.",
   "و va ي ni har doim «v» va «y» deb o'qish. Cho'zishda ular «uu» va «ii» bo'lib ketadi.",
   "Cho'ziqlikni oldingi harakat belgilaydi — damma + و = uu, kasra + ي = ii. Bularni chalkashtirmang."
  ]
 },
