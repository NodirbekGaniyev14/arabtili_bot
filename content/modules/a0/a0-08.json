    "form": "alohida"
   },
   {
    "ar": "بـ ـبـ ـب ب",
    "uz": "ب harfining 4 shakli",
    "form": "misol"
   },
   {
    "ar": "د ذ ر ز و ا",
    "uz": "chapga ulanmaydigan 6 harf",
    "form": "ulanmas"
   }
  ],
  "common_mistakes_uz": [
   "ا د ذ ر ز و harflaridan keyin qalamni uzmasdan davom ettirish — noto'g'ri. Ulardan keyin yangi harf alohida boshlanadi.",
   "So'z oxiridagi harfning 'dumini' (masalan ـن, ـم) tushirib qoldirish.",
   "Harfning o'rta shaklini so'z boshida ishlatib yuborish — har pozitsiyaning o'z shakli bor."
  ]
 },
