    "uz": "m — 'meva' dagi 'm'",
    "form": "mim"
   },
   {
    "ar": "ه",
    "uz": "h — 'havo' dagi 'h' (yengil)",
    "form": "ha"
   },
   {
    "ar": "و",
    "uz": "w/u — 'vov' (ingliz 'w' ga o'xshash)",
    "form": "vov"
   }
  ],
  "common_mistakes_uz": [
   "ق (q) va ك (k) ni aralashtirish — ق chuqur tomoqdan, ك yumshoq va oldindan chiqadi.",
   "و ni o'zbekcha 'v' kabi qattiq aytish — arabchada u yumshoqroq, ingliz 'w' ga yaqin.",
   "ه (yengil h) ni ح (kuchli h) bilan aralashtirish — ه ancha yengil talaffuz qilinadi."
  ]
