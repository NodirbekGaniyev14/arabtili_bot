    "uz": "\"d\" tovushi, nuqtasiz",
    "form": "دَرْس"
   },
   {
    "ar": "ذ",
    "uz": "tishlararo \"z\" (inglizcha 'the' dagi kabi), ustida 1 nuqta",
    "form": "ذَهَب"
   },
   {
    "ar": "ر",
    "uz": "\"r\" tovushi, nuqtasiz",
    "form": "وَرْد"
   },
   {
    "ar": "ز",
    "uz": "\"z\" tovushi, ustida 1 nuqta",
    "form": "زَيْت"
   }
  ],
  "common_mistakes_uz": [
   "د va ذ ni aralashtirib yuborish — farqi faqat ustidagi nuqta (ذ da nuqta bor).",
   "ر va ز ni aralashtirish — ز ning ustida nuqta bor, ر da yo'q.",
   "ذ ni oddiy \"z\" deb o'qish — aslida u tishlararo, yumshoqroq tovush.",
   "Bu harflardan keyingi harfni ularga ulab yozishga urinish — ular keyingisiga ulanmaydi."
  ]
 },
