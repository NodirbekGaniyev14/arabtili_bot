 "harakat_level": "full",
 "hook_uz": "Arab yozuvida unlilar harflar emas — ular kichik belgilar. Bitta so'z «كتب» dan belgilar bilan «kataba» (yozdi) ham, «kutub» (kitoblar) ham chiqadi. O'zbekchadagi «kitob» so'zi ham aynan shu o'zakdan!",
 "grammar": {
  "point_ar": "الفَتْحة · الكَسْرة · الضَّمّة",
  "explanation_uz": "Arab tilida qisqa unlilar (a, i, u) alohida harf emas, balki harf ustiga yoki ostiga qo'yiladigan mayda belgilardir. Uchtasi bor: fatha (kichik chiziq, harf USTIDA) = a; kasra (kichik chiziq, harf OSTIDA) = i; damma (kichik و shakli, harf USTIDA) = u. Bu belgilar so'z ma'nosini butunlay o'zgartiradi: كَتَبَ = «yozdi», كُتُبُ = «kitoblar».",
  "table": [
   {
    "ar": "بَ",
    "uz": "ba (a tovushi)",
    "form": "fatha — harf ustida chiziq"
   },
   {
    "ar": "بِ",
    "uz": "bi (i tovushi)",
    "form": "kasra — harf ostida chiziq"
   },
   {
    "ar": "بُ",
    "uz": "bu (u tovushi)",
    "form": "damma — harf ustida و shakli"
   },
   {
    "ar": "كَتَبَ",
    "uz": "kataba — yozdi",
    "form": "uchta fatha"
   },
   {
    "ar": "كُتُبُ",
    "uz": "kutub — kitoblar",
    "form": "uchta damma"
   }
  ],
  "common_mistakes_uz": [
   "Kasrani harf ustiga qo'yish — kasra HAR DOIM harf OSTIDA.",
   "Fatha (a) va damma (u) ni chalkashtirish — damma kichik «و» shakliga o'xshaydi.",
   "Harakatlarni o'qimay tashlab ketish — har bir belgi tovush beradi, o'qish shart."
  ]
 },
