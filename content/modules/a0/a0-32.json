 "harakat_level": "full",
 "hook_uz": "«Islom» so'zi arabchada إِسْلام deb yoziladi — boshidagi kichkina belgi «hamza». Bu tovush o'zbekchada ham bor: «sa'at», «ma'no» so'zlaridagi uzilishga o'xshaydi. Hamza — bir qisqa, keskin to'xtash tovushi.",
 "grammar": {
  "point_ar": "الهَمْزَة",
  "explanation_uz": "Hamza (ء) — bir undosh tovush bo'lib, tomoqda havoni bir lahzaga to'xtatib qo'yadigan «uzilish» tovushidir. U yolg'iz (ء) ham, yoki bir «kursi» (tayanch harf) ustida ham yoziladi: أ va إ (alif ustida/ostida), ؤ (vov ustida), ئ (yo ustida — nuqtasiz). Qaysi shaklda yozilishi hamzaning so'zdagi o'rniga va yonidagi harakatlarga bog'liq. Hozircha eng muhimi — bu shakllarning HAMMASI bitta tovush ekanini bilish.",
  "table": [
   {
    "ar": "ء",
    "uz": "yolg'iz hamza (kursisiz)",
    "form": "مَاء"
   },
   {
    "ar": "أ",
    "uz": "alif ustida hamza (fatha yoki damma bilan)",
    "form": "أَب"
   },
   {
    "ar": "إ",
    "uz": "alif ostida hamza (kasra bilan)",
    "form": "إِسْلام"
   },
   {
    "ar": "ؤ",
    "uz": "vov ustida hamza",
    "form": "سُؤَال"
   },
   {
    "ar": "ئ",
    "uz": "yo (nuqtasiz) ustida hamza",
    "form": "بِئْر"
   }
  ],
  "common_mistakes_uz": [
   "أ va إ ni oddiy alif (cho'ziq unli) deb o'qish — yo'q, bular hamza (undosh tovush).",
   "ؤ ni «v» tovushi deb o'qish — bu yerda vov faqat kursi, o'qilishi hamza.",
   "ئ ostidagi tayanch nuqtasiz — uni «y» deb o'qimang, bu ham hamza.",
   "Hamzani butunlay tashlab ketish — u albatta talaffuz qilinadi (qisqa to'xtash)."
  ]
 },
