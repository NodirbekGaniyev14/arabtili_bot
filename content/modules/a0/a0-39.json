 "title_uz": "O'qish ustaxonasi",
 "title_ar": "وَرْشَةُ القِرَاءَة",
 "can_do_uz": "Tanish 50 ta so'zni harakatlari bilan ravon va vaqtli o'qiy olaman.",
 "duration_min": 30,
 "prerequisites": ["a0-38"],
 "harakat_level": "full",
 "hook_uz": "Endi harflarni bilasiz, harakatlarni bilasiz — vaqt keldi ravon o'qishga! Xuddi 'kitob' (كِتَاب) so'zi arabchadan o'zbekchaga o'tgani kabi, ko'p so'zlar sizga allaqachon tanish. Bugun 50 ta so'zni sekundomer bilan o'qiymiz.",
 "grammar": {
  "point_ar": "القِرَاءَة",
  "explanation_uz": "Ravon o'qish uchun uchta narsani birlashtirasiz: (1) harfning boshi/o'rtasi/oxiri shakli, (2) qisqa unlilar (fatha/kasra/damma), (3) cho'ziq unlilar (madd). O'qishda ko'zingizni O'NGDAN CHAPGA harakatlantiring va bo'g'inlab (bo'lib) o'qing: كِ + تَا + بٌ.",
  "table": [
   {
    "ar": "بَيْت",
    "uz": "uy — bay-t",
    "form": "1 bo'g'in + sukun"
   },
   {
    "ar": "كِتَاب",
    "uz": "kitob — ki-taab",
    "form": "cho'ziq alif (aa)"
   },
   {
    "ar": "مَدْرَسَة",
    "uz": "maktab — mad-ra-sa",
    "form": "ta marbuta (a) oxirida"
   },
   {
    "ar": "قَلَم",
    "uz": "qalam — qa-lam",
    "form": "3 harf, oddiy"
   },
   {
    "ar": "الشَّمْس",
    "uz": "quyosh — ash-shams",
    "form": "quyosh harfi, lam yozilmaydi"
   }
  ],
  "common_mistakes_uz": [
   "Chapdan o'ngga o'qish — arabchada har doim O'NGDAN CHAPGA!",
   "Cho'ziq unlini (اا) qisqa o'qib yuborish: كِتَاب 'kitaab' bo'ladi, 'kitab' emas.",
   "Ta marbuta (ة) ni 'h' emas, to'xtaganda '-a' deb o'qish: مَدْرَسَة → 'madrasa'.",
   "Quyosh harflarida ال ning 'l' tovushini o'qib yuborish: الشَّمْس → 'ashshams', 'alshams' emas."
  ]
 },
