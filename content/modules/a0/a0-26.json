    "form": "sukun"
   },
   {
    "ar": "دَرْس",
    "uz": "dars — رْ = 'r' unlisiz",
    "form": "sukun"
   },
   {
    "ar": "عِلْم",
    "uz": "ilm — لْ = 'l' unlisiz",
    "form": "sukun"
   },
   {
    "ar": "بِنْت",
    "uz": "bint (qiz) — نْ = 'n' unlisiz",
    "form": "sukun"
   }
  ],
  "common_mistakes_uz": [
   "Sukunli harfga unli qo'shib o'qish: مَكْتَب ni 'makatab' emas, 'maktab' deb o'qing.",
   "Sukun ( ْ ) belgisini damma ( ُ ) bilan chalkashtirish — sukun to'liq doiracha, damma esa kichik 'و' shaklida.",
   "So'zning eng oxirgi harfida ko'pincha unli tushiriladi (vaqf) — u ham unlisiz, sukunga o'xshab o'qiladi."
  ]
 },
