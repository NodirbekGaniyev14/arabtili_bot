 "title_uz": "Harf oilasi 2: ج ح خ",
 "title_ar": "ج ح خ",
 "can_do_uz": "Bir xil shakldagi uch harfni (ج ح خ) nuqtasiga qarab ajrata olaman va ularning tovushlarini to'g'ri aytaman.",
 "duration_min": 30,
 "prerequisites": [
  "a0-02"
 ],
 "harakat_level": "full",
 "hook_uz": "خ tovushi siz uchun yangi emas — o'zbekchadagi 'xat', 'xona', 'xush' so'zlaridagi 'x' aynan shu. Endi bitta 'qozon' shaklga uchta nuqta joylashuvini o'rgansangiz — ج ح خ oilasi qo'lingizda!",
 "grammar": {
  "point_ar": "ج ح خ",
  "explanation_uz": "Bu uchta harf bir xil 'qozon/tovoq' shaklga ega. Ular faqat nuqta bilan farq qiladi: ج — pastda bitta nuqta, ح — nuqtasiz, خ — ustida bitta nuqta. Tovushlari esa butunlay boshqa: ج (j) — o'zbekcha 'jon' dagi 'j'; ح (h) — tomoqning ichidan chiqadigan chuqur, bo'g'iq nafas tovushi (o'zbekchada aniq mos yo'q); خ (x) — o'zbekcha 'xat' dagi 'x'.",
  "table": [
   {
    "ar": "ج",
    "uz": "pastda nuqta — 'j' (jon)",
    "form": "nuqta ostda"
   },
   {
    "ar": "ح",
    "uz": "nuqtasiz — chuqur, bo'g'iq 'h'",
    "form": "nuqtasiz"
   },
   {
    "ar": "خ",
    "uz": "ustida nuqta — 'x' (xat)",
    "form": "nuqta ustda"
   }
  ],
  "common_mistakes_uz": [
   "ح ni oddiy o'zbekcha 'h' (hech) deb o'qish — aslida u tomoqdan chiqadigan kuchliroq, bo'g'iq tovush.",
   "خ ni ح bilan chalkashtirish: nuqta USTIDA bo'lsa — خ (x), nuqta yo'q bo'lsa — ح.",
   "ج dagi nuqtani ustiga qo'yib yozish — ج da nuqta doim PASTDA."
  ]
 },
