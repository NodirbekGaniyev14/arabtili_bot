   {"ar": "ا + ب = اب", "uz": "alifdan keyin uzilish", "form": "ulanmaydi"},
   {"ar": "د + ت = دت", "uz": "doldan keyin uzilish", "form": "ulanmaydi"}
  ],
  "common_mistakes_uz": [
   "Ulanmaydigan harfdan (ا د ذ ر ز و) keyin ham tutashtirishga urinish.",
   "Harflarni yakka shaklda yonma-yon qo'yib «ulandi» deb o'ylash — ular TUTASHADI.",
   "Ulanma harakatini (unlisini) o'ylash — hozir faqat SHAKL, tovush keyin."
  ]
 },
