   {"ar": "منظرٌ خلّابٌ", "uz": "maftunkor manzara", "form": "sifat"},
   {"ar": "تحيطُ بها الجبالُ", "uz": "uni tog'lar o'rab turadi", "form": "qolip"}
  ],
  "common_mistakes_uz": [
