   {"ar": "صَحَفِيّ · قَانُونِيّ", "uz": "jurnalist · huquqshunos", "form": "nisba"},
   {"ar": "أعملُ مهندسًا", "uz": "muhandis bo'lib ishlayman", "form": "qolip"}
