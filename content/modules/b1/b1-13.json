 "grammar": {
  "point_ar": "لَمْ، لَمَّا، لَا النَّاهِيَة، لَامُ الأَمْر",
  "explanation_uz": "JAZM QILUVCHILAR: (1) لَمْ — o'tgan zamon inkori: لم يذهبْ (bormadi) — ma'no o'tgan, shakl muzori'!; (2) لَمَّا — «hali ...gani yo'q»: لمّا يصلْ (hali yetib kelgani yo'q); (3) لَا النَّاهِيَة — taqiq: لا تخفْ (qo'rqma!); (4) لَامُ الأَمْر — «...sin» buyrug'i: لِيَكْتُبْ (yozsin). JAZM ALOMATLARI: sog'lomda sukun (يذهبْ); illatlida oxirgi harf tushadi (يقولُ→يقلْ, يمشي→يمشِ, يدعو→يدعُ); af'olul-xamsada نون tushadi (يذهبون→لم يذهبوا).",
  "table": [
   {"ar": "لم أذهبْ أمسِ", "uz": "kecha bormadim (o'tgan inkor)", "form": "لَمْ"},
   {"ar": "لمّا يصلِ القطارُ", "uz": "poyezd hali kelgani yo'q", "form": "لَمَّا"},
   {"ar": "لا تخفْ ولا تحزنْ", "uz": "qo'rqma va xafa bo'lma!", "form": "لا الناهية"},
   {"ar": "لِيَحْضُرْ كلُّ طالبٍ", "uz": "har bir talaba kelsin", "form": "لام الأمر"}
  ],
  "common_mistakes_uz": [
   "لم bilan o'tgan shaklni qo'yish: لم ذهبَ — XATO; لم + muzori' majzum: لم يذهبْ.",
   "Illatli fe'lda harfni tushirmaslik: لم يقولْ emas — لم يقلْ.",
   "لا الناهية (taqiq, jazm) bilan لا النافية (oddiy inkor: لا أعرفُ) ni adashtirish."
  ]
 },
