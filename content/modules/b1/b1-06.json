 "grammar": {
  "point_ar": "لَوْ + مَاضٍ، لَـ + مَاضٍ",
  "explanation_uz": "لَوْ — XAYOLIY (amalga oshmagan) shart: ikkala fe'l o'tgan zamonda, javob oldiga لَـ qo'shiladi: لو اجتهدتَ لَنجحتَ — tirishganingda edi, (albatta) muvaffaq bo'larding. INKOR sharti: لَوْلَا (bo'lmaganida edi) + ot: لولا الماءُ لَماتَ الزرعُ — suv bo'lmaganida, ekin nobud bo'lardi. TAQQOSLASH: إذا/إنْ — real kelajak; لو — o'tgan, bo'lmagan ish. Orzu ma'nosida ham: لو كنتُ طائرًا — qushcha bo'lganimda edi!",
  "table": [
   {"ar": "لو درستَ لَنجحتَ", "uz": "o'qiganingda edi, muvaffaq bo'larding", "form": "لو + لَـ"},
