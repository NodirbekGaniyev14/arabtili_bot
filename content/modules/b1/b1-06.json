   {"ar": "لولا الماءُ لَماتَ الزرعُ", "uz": "suv bo'lmaganida, ekin qurirdi", "form": "لولا + ot"},
   {"ar": "إذا درستَ نجحتَ", "uz": "solishtiring: real shart (bo'lishi mumkin)", "form": "farq"}
  ],
  "common_mistakes_uz": [
