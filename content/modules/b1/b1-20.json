   "questions": [
    {"q_uz": "Ota nimani bilmasdi?", "a": "Yangi telefonni ishlatishni"},
    {"q_uz": "Farzand nimalarni o'rgatdi?", "a": "Ilovalarni ochish, xabar va surat yuborishni"},
    {"q_uz": "Ota nimadan hayratlandi?", "a": "Ilgari xabar bir haftada, endi bir soniyada yetadi"}
   ]
