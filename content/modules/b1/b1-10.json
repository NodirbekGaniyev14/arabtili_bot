 "grammar": {
  "point_ar": "الفِعْل + مَصْدَرُهُ مَنْصُوبًا",
  "explanation_uz": "MAF'UL MUTLAQ — fe'ldan keyin kelgan O'ZINING masdari, NASB holatida. Uch maqsadi: (1) TA'KID: فهمتُ فهمًا — chindan tushundim; (2) TUR bildirish (masdar + sifat yoki idofa): فهمتُ فهمًا عميقًا — chuqur tushundim; سرتُ سيرَ العقلاءِ — aqllilardek yurdim; (3) SON bildirish: دقَّ البابَ دقَّتَيْنِ — eshikni ikki marta taqilladi. Masdar fe'l bilan bir o'zakdan bo'ladi: فهم→فهمًا, قرأ→قراءةً, كلّم→تكليمًا.",
  "table": [
   {"ar": "فهمتُ الدرسَ فهمًا", "uz": "darsni chindan tushundim (ta'kid)", "form": "ta'kid"},
   {"ar": "فهمتُ فهمًا عميقًا", "uz": "chuqur tushundim (tur)", "form": "tur"},
   {"ar": "دقَّ البابَ دقتينِ", "uz": "eshikni ikki marta taqilladi (son)", "form": "son"},
   {"ar": "كلّمهُ تكليمًا", "uz": "u bilan rosa gaplashdi (II bob masdari)", "form": "bob masdari"}
  ],
  "common_mistakes_uz": [
   "Masdarni raf'da qoldirish: فهمًا kerak, فهمٌ emas.",
   "Boshqa o'zak masdarini qo'yish: فهمتُ قراءةً — mantiqsiz; fe'lning O'Z masdari kerak.",
   "II bob fe'liga I bob masdarini qo'shish: كلّم uchun كلامًا emas — تكليمًا."
  ]
 },
