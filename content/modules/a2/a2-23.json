 "hook_uz": "«Katta» — كَبِير. «Kattaroq» — أَكْبَر. «Allohu akbar» — Alloh ENG BUYUK! Sifatni أَفْعَل vazniga solsangiz — solishtirma daraja chiqadi: أَجْمَل (chiroyliroq), أَحْسَن (yaxshiroq).",
 "grammar": {
  "point_ar": "اسْمُ التَّفْضِيل",
  "explanation_uz": "Solishtirish uchun sifat أَفْعَل vazniga solinadi: كَبِير → أَكْبَر, جَمِيل → أَجْمَل, حَسَن → أَحْسَن. «...dan kattaroq» = أَفْعَل + مِن: هَذَا أَكْبَرُ مِنْ ذَلِكَ. «Eng ...» (orttirma) = الأَفْعَل yoki أَفْعَل + idafa: الأَكْبَر (eng katta), أَكْبَرُ بَيْتٍ (eng katta uy). أَفْعَل erkak-ayol uchun bir xil.",
  "table": [
   {"ar": "كَبِير ← أَكْبَر", "uz": "katta → kattaroq", "form": "أَفْعَل"},
   {"ar": "هَذَا أَكْبَرُ مِنْ ذَلِكَ", "uz": "Bu undan kattaroq", "form": "أَفْعَل مِن"},
   {"ar": "الأَكْبَر / أَكْبَرُ بَيْتٍ", "uz": "eng katta / eng katta uy", "form": "orttirma"},
   {"ar": "أَحْسَن · أَجْمَل · أَطْوَل", "uz": "yaxshiroq · chiroyliroq · balandroq", "form": "misollar"}
  ],
  "common_mistakes_uz": [
   "أَفْعَل ni ayol uchun o'zgartirish — u erkak-ayol uchun bir xil.",
   "«...dan» uchun مِن ni unutish: أَكْبَر مِن.",
   "Ba'zi sifatlar (rang, ayb) أَفْعَل ni boshqacha yasaydi — asosiylarni yodlang."
  ]
 },
