 "grammar": {
  "point_ar": "الأَعْدَادُ مِنْ مِئَة",
  "explanation_uz": "100 va undan katta sonlar (مِئَة, أَلْف, مِلْيُون) dan keyin sanaladigan ot BIRLIK va JARRda bo'ladi: مِئَةُ رَجُلٍ (100 kishi), أَلْفُ رِيَالٍ (1000 riyol). Diqqat: 3–10 dan keyin ot ko'plik-jarr edi (a1-34), lekin 100+ dan keyin BIRLIK-jarr. Ulushlar (kasrlar): نِصْف (1/2), ثُلُث (1/3), رُبْع (1/4).",
  "table": [
   {"ar": "مِئَةُ رَجُلٍ", "uz": "100 kishi (birlik-jarr)", "form": "100+"},
