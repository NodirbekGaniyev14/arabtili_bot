   {"ar": "البَابُ قَدِيمٌ", "uz": "Eshik eski", "form": "ismli gap"},
   {"ar": "الوَلَدُ طَوِيلٌ", "uz": "Bola baland (bo'yli)", "form": "ismli gap"}
  ],
  "common_mistakes_uz": [
   "«bo'ladi / is» ma'nosida qo'shimcha so'z qo'shishga urinish — arabchada kerak EMAS.",
   "Egani noaniq qoldirish — odatda ega ال bilan aniq bo'ladi (البَيْت), xabar tanvin bilan noaniq (كَبِيرٌ).",
   "Oxirgi harakatni unutish — ega va xabar «raf'» da: ـُ yoki ـٌ."
  ]
 },
