   {"ar": "مَا اسْمُكَ؟ — اسْمِي...", "uz": "Ismingiz nima? — Ismim...", "form": "tanishuv"},
   {"ar": "مِنْ أَيْنَ أَنْتَ؟", "uz": "Qayerdansiz?", "form": "kelib chiqish"}
