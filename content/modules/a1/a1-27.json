 "grammar": {
  "point_ar": "جَمْعُ التَّكْسِير",
  "explanation_uz": "«Singan ko'plik» (جمع التكسير) — so'z ichki tuzilishi o'zgaradi (qo'shimcha emas). Narsalar va ko'p so'zlar shu ko'plikni oladi. Asosiy vaznlar: فُعُل (كِتَاب→كُتُب), فُعُول (بَيْت→بُيُوت), أَفْعَال (وَلَد→أَوْلَاد, قَلَم→أَقْلَام), فِعَال (رَجُل→رِجَال). Har so'zning ko'pligini lug'atdan yodlang — lekin vaznlar tanish bo'lib boradi.",
  "table": [
   {"ar": "كِتَاب ← كُتُب", "uz": "kitob → kitoblar", "form": "فُعُل"},
   {"ar": "بَيْت ← بُيُوت", "uz": "uy → uylar", "form": "فُعُول"},
   {"ar": "وَلَد ← أَوْلَاد", "uz": "bola → bolalar", "form": "أَفْعَال"},
   {"ar": "رَجُل ← رِجَال", "uz": "erkak → erkaklar", "form": "فِعَال"}
  ],
  "common_mistakes_uz": [
   "Narsalarga sog'lom ko'plik (ـُونَ) qo'shish — ular ko'pincha singan ko'plik oladi.",
   "Singan ko'plik vaznini o'zak bilan chalkashtirish — o'zak harflari saqlanadi.",
   "Har so'zning ko'pligini «qoida» bilan yasashga urinish — ko'pini yodlash kerak."
  ]
 },
