 "hook_uz": "Arabchada «yo'q/emas» uchun bir necha so'z bor, har biri o'z o'rnida: لَيْسَ (emas), مَا (o'tgan), لا (hozirgi), لَنْ (kelasi). To'g'risini tanlashni o'rgansangiz — inkorni mukammal bajarasiz!",
 "grammar": {
  "point_ar": "لَيْسَ · ما · لا · لَمْ · لَنْ",
  "explanation_uz": "Inkor vositalari: (1) لَيْسَ — ismli gapni inkor qiladi («emas»): لَيْسَ الطَّالِبُ حَاضِرًا (talaba hozir emas; xabar nasb bo'ladi). (2) مَا + o'tgan fe'l: مَا ذَهَبَ (bormadi). (3) لا + hozirgi fe'l: لا يَذْهَبُ (bormaydi). (4) لَنْ + hozirgi fe'l: لَنْ يَذْهَبَ (bormaydi — kelasi inkori). (5) لَمْ + hozirgi shakl: لَمْ يَذْهَبْ (bormadi — o'tganning kuchli inkori). Vaqt va gap turiga qarab tanlang.",
  "table": [
   {"ar": "لَيْسَ ... حَاضِرًا", "uz": "... hozir emas", "form": "ismli gap"},
   {"ar": "مَا ذَهَبَ", "uz": "bormadi (o'tgan)", "form": "ما + ma'zi"},
   {"ar": "لا يَذْهَبُ", "uz": "bormaydi (hozirgi)", "form": "لا + muzori'"},
   {"ar": "لَنْ يَذْهَبَ", "uz": "bormaydi (kelasi)", "form": "لَنْ + muzori'"}
  ],
  "common_mistakes_uz": [
   "لَيْسَ dan keyin xabarni raf' qoldirish — u nasb (fatha) bo'ladi: حَاضِرًا.",
   "Kelasi zamonni لا bilan inkor qilish — kelasi uchun لَنْ.",
   "Har inkor so'zini bir xil deb o'ylash — zamon/gap turi muhim."
  ]
 },
