   {"ar": "الشَّمْس", "uz": "quyosh — «ash-shams» (l yutiladi)", "form": "quyosh harfi"},
   {"ar": "المَسْجِدُ كَبِيرٌ", "uz": "Masjid katta", "form": "aniq ega + noaniq xabar"}
  ],
  "common_mistakes_uz": [
   "الـ bilan birga tanvin qo'yish — noto'g'ri: «المَدِينَةٌ». To'g'ri: المَدِينَةُ (tanvinsiz).",
