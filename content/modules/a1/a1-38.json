   {"ar": "بِالحَافِلَةِ / بِالقِطَارِ", "uz": "avtobusda / poyezdda", "form": "transport"},
   {"ar": "كَيْفَ أَصِلُ إِلَى الفُنْدُقِ؟", "uz": "Mehmonxonaga qanday yetaman?", "form": "namuna"}
  ],
  "common_mistakes_uz": [
   "يَمِين (o'ng) va يَسَار (chap) ni chalkashtirish.",
   "Transport uchun بِـ (vosita) predlogini unutish: بِالسَّيَّارَةِ.",
