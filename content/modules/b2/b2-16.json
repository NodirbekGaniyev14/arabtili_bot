   {"ar": "اِسْتِعْمَال", "uz": "foydalanish (X bob masdari)", "form": "اِسْتِفْعَال"},
   {"ar": "مُعَامَلَة", "uz": "muomala (III bob masdari)", "form": "مُفَاعَلَة"}
  ],
  "common_mistakes_uz": [
   "Vaznni e'tiborsiz qoldirib faqat o'zakdan ma'no chiqarish: مَعْمَل (zavod) ≠ عَامِل (ishchi).",
