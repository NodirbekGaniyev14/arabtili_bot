   {"ar": "عَلَى قَدَمٍ وَسَاقٍ", "uz": "Jadal sur'atda ketmoqda", "form": "تَعْبِير"},
   {"ar": "بَيْنَ عَشِيَّةٍ وَضُحَاهَا", "uz": "Bir kechada, juda tez", "form": "تَعْبِير"},
   {"ar": "يَدًا بِيَدٍ", "uz": "Qo'l-qo'lda, hamkorlikda", "form": "تَعْبِير"},
   {"ar": "ضَرَبَ عُصْفُورَيْنِ بِحَجَرٍ", "uz": "Bir o'q bilan ikki quyon", "form": "مَثَل"}
  ],
  "common_mistakes_uz": [
   "Idiomani so'zma-so'z tarjima qilish: «فِي المِشْمِشِ» — «o'rikda» emas, «hech qachon».",
   "Kinoyani isti'ora deb belgilash — kinoyada asl ma'no ham to'g'ri bo'lishi mumkin.",
   "Idiomaning so'zlarini o'zgartirish: «عَلَى رِجْلٍ وَسَاقٍ» ✗ — birikma qat'iy."
  ]
 },
