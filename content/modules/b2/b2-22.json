   {"ar": "وَاجَهَ تَحَدِّيًا", "uz": "muammoga duch keldi", "form": "تَحَدٍّ"},
   {"ar": "عَقَدَ اِجْتِمَاعًا", "uz": "yig'ilish o'tkazdi", "form": "اِجْتِمَاع"}
  ],
  "common_mistakes_uz": [
