 "writing": [
  {
   "task_uz": "«عَلِمَ» o'zagidan (ع ل م) 4 so'z yozing: II bob fe'li, V bob fe'li, ism fo'il va masdar."
  },
  {
   "task_uz": "«Havo sovuq edi» (كانَ bilan) va «Haqiqatan talaba tirishqoq» (إنَّ bilan) gaplarini yozing — holatlarga e'tibor bering."
  },
  {
   "task_uz": "Uch buyruq fe'li yozing (yoz!, o'qi!, eshit!) va bittasini gapda ishlating."
  },
  {
   "task_uz": "Saudiyaga safar haqida 4 gap yozing: aeroport, taksi, mehmonxona, Haram."
  },
  {
   "task_uz": "«كَتَبَ» ni majhulga aylantiring va solishtirma daraja (أَفْعَل) bilan bir gap tuzing."
  },
  {
   "task_uz": "Illatli fe'l bilan 2 gap yozing: bittasi قَالَ (ajvaf), bittasi مَشَى (naqis) bilan."
  },
  {
   "task_uz": "Bozordagi suhbatni 4 gapda yozing: narx so'rash, savdolashish, to'lash, rahmat."
  }
 ],
