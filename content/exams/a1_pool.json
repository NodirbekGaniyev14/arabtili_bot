 "writing": [
  {
   "task_uz": "«Men talabaman» va «U shifokor» gaplarini arabcha yozing (olmosh + xabar)."
  },
  {
   "task_uz": "Bir fe'lni (masalan ذَهَبَ) uch zamonda yozing: kecha bordim, hozir boraman, ertaga boraman."
  },
  {
   "task_uz": "Oilangiz haqida 2 gap yozing (bobom/amakim... egalik olmoshlari bilan)."
  },
  {
   "task_uz": "«uy eshigi» va «maktab direktori» iboralarini idafa bilan yozing."
  },
  {
   "task_uz": "ك ت ب o'zagidan 4 so'z yozing va har birining ma'nosini ko'rsating."
  },
  {
   "task_uz": "Bugungi kuningiz haqida 3 gap yozing (hozirgi zamon, muzori')."
  },
  {
   "task_uz": "«mening oilam» va «uning uyi» iboralarini yozing (egalik olmoshlari)."
  }
 ],
